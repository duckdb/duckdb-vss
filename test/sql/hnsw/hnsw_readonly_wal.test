# name: test/sql/hnsw/hnsw_readonly_wal.test
# description: Recover HNSW deletes from the WAL in a read-only database
# group: [hnsw]

require vss

require noforcestorage

load {TEST_DIR}/hnsw_readonly_wal.db

statement ok
SET hnsw_enable_experimental_persistence = true;

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold = '1TB';

statement ok
CREATE TABLE items (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO items VALUES (1, [0, 0, 0]), (2, [1, 0, 0]), (3, [2, 0, 0]);

statement ok
CREATE INDEX items_idx ON items USING HNSW (vec);

statement ok
CHECKPOINT;

# Keep the deletion in the WAL while the persisted index still contains all three rows.
statement ok
DELETE FROM items WHERE id = 1;

load {TEST_DIR}/hnsw_readonly_wal.db readonly

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

query I
SELECT count(*) FROM items;
----
2

query II
EXPLAIN SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
physical_plan	<REGEX>:.*HNSW_INDEX_SCAN.*

query I
SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
2

query I
SELECT count FROM pragma_hnsw_index_info();
----
2

statement error
DELETE FROM items WHERE id = 2;
----
read-only

# Read-only recovery leaves the WAL available for a subsequent writable reopen.
load

statement ok
ATTACH '{TEST_DIR}/hnsw_readonly_wal.db' AS recovered;

statement ok
USE recovered;

query I
SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
2

query I
SELECT count FROM pragma_hnsw_index_info();
----
2

statement ok
DELETE FROM items WHERE id = 2;

statement ok
CHECKPOINT;

# A read-only reopen also works when the deletes have already been checkpointed.
load {TEST_DIR}/hnsw_readonly_wal.db readonly

query I
SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
3

query I
SELECT count FROM pragma_hnsw_index_info();
----
1
