# name: test/sql/hnsw/hnsw_insert_wal.test
# description: Recover HNSW inserts and interleaved deletes from the WAL
# group: [hnsw]

require vss

require noforcestorage

load {TEST_DIR}/hnsw_insert_wal.db

statement ok
SET hnsw_enable_experimental_persistence = true;

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold = '1TB';

statement ok
CREATE TABLE items (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO items SELECT i, [i + 10, 0, 0] FROM range(64) t(i);

statement ok
CREATE INDEX items_idx ON items USING HNSW (vec);

statement ok
CHECKPOINT;

# Leave inserts in the WAL, including a NULL that is not stored in HNSW.
statement ok
INSERT INTO items VALUES (100, [0, 0, 0]), (101, NULL), (102, [1000, 0, 0]);

restart

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

query I
SELECT count(*) FROM items;
----
67

query II
EXPLAIN SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
physical_plan	<REGEX>:.*HNSW_INDEX_SCAN.*

query I
SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
100

query I
SELECT count FROM pragma_hnsw_index_info();
----
66

statement ok
CHECKPOINT;

# Replay inserts and deletes against the checkpointed index.
statement ok
INSERT INTO items VALUES (103, [1, 0, 0]), (104, [2000, 0, 0]);

statement ok
DELETE FROM items WHERE id IN (100, 101, 104);

statement ok
INSERT INTO items VALUES (105, [3000, 0, 0]);

query I
SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
103

restart

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

query I
SELECT count(*) FROM items;
----
67

query II
EXPLAIN SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
physical_plan	<REGEX>:.*HNSW_INDEX_SCAN.*

query I
SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
103

query I
SELECT id FROM items ORDER BY array_distance(vec, [3000, 0, 0]::FLOAT[3]) LIMIT 1;
----
105

query I
SELECT count FROM pragma_hnsw_index_info();
----
67

# Recovered changes also survive a checkpoint and another restart.
statement ok
CHECKPOINT;

restart

query I
SELECT id FROM items ORDER BY array_distance(vec, [0, 0, 0]::FLOAT[3]) LIMIT 1;
----
103

query I
SELECT id FROM items ORDER BY array_distance(vec, [3000, 0, 0]::FLOAT[3]) LIMIT 1;
----
105

query I
SELECT count FROM pragma_hnsw_index_info();
----
67
