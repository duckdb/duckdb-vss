# name: test/sql/hnsw/hnsw_crud.test
# group: [hnsw]

require vss

# Step 0: Open a database
load {TEST_DIR}/temp_index_hnsw_crud_storage.db

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
SET hnsw_enable_experimental_persistence = true;

statement ok
CREATE TABLE t1 (vec FLOAT[3]);

statement ok
INSERT INTO t1 VALUES (array[1.0, 2.0, 3.0]);

statement ok
CREATE INDEX my_idx ON t1 USING HNSW (vec);

statement ok
CHECKPOINT;

statement ok
INSERT INTO t1 VALUES (array[5.0, 5.0, 5.0]);

statement ok
DELETE FROM t1 WHERE vec = array[1.0, 2.0, 3.0];

query I
SELECT count FROM pragma_hnsw_index_info();
----
1

query I
SELECT * FROM t1;
----
[5.0, 5.0, 5.0]

query I
SELECT * FROM t1 ORDER BY array_distance(vec, [1,2,3]::FLOAT[3]) LIMIT 1;
----
[5.0, 5.0, 5.0]

# Restart the database
restart

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

# Step 2: Check the index
query I
SELECT count FROM pragma_hnsw_index_info();
----
1

query II
EXPLAIN SELECT * FROM t1 ORDER BY array_distance(vec, [1,2,3]::FLOAT[3]) LIMIT 1;
----
physical_plan	<REGEX>:.*HNSW_INDEX_SCAN.*

query I
SELECT * FROM t1 ORDER BY array_distance(vec, [1,2,3]::FLOAT[3]) LIMIT 1;
----
[5.0, 5.0, 5.0]

statement ok
PRAGMA hnsw_compact_index('my_idx');

# Deleting remains correct after compaction has reassigned USearch slots.
statement ok
CREATE TABLE t2 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t2 SELECT i, [i::FLOAT, 0, 0]::FLOAT[3] FROM range(100) r(i);

statement ok
CREATE INDEX t2_idx ON t2 USING HNSW (vec);

statement ok
DELETE FROM t2 WHERE id % 2 = 0;

statement ok
PRAGMA hnsw_compact_index('t2_idx');

statement ok
DELETE FROM t2 WHERE id = 1;

query I
SELECT count FROM pragma_hnsw_index_info() WHERE index_name = 't2_idx';
----
49

query I
SELECT id FROM t2 ORDER BY array_distance(vec, [1,0,0]::FLOAT[3]) LIMIT 1;
----
3

# NULL vectors are not present in HNSW and should not count as failed deletions.
statement ok
CREATE TABLE t3 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t3 VALUES (1, NULL), (2, [2, 2, 2]);

statement ok
CREATE INDEX t3_idx ON t3 USING HNSW (vec);

query I
SELECT count FROM pragma_hnsw_index_info() WHERE index_name = 't3_idx';
----
1

statement ok
DELETE FROM t3 WHERE id = 1;

query I
SELECT count FROM pragma_hnsw_index_info() WHERE index_name = 't3_idx';
----
1

statement ok
DELETE FROM t3 WHERE id = 2;

query I
SELECT count FROM pragma_hnsw_index_info() WHERE index_name = 't3_idx';
----
0

# Indexed-column updates are rewritten to DELETE + INSERT.
statement ok
CREATE TABLE t4 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t4 VALUES (1, [1, 1, 1]);

statement ok
CREATE INDEX t4_idx ON t4 USING HNSW (vec);

statement ok
UPDATE t4 SET vec = [10, 10, 10] WHERE id = 1;

query I
SELECT count FROM pragma_hnsw_index_info() WHERE index_name = 't4_idx';
----
1

query I
SELECT id FROM t4 ORDER BY array_distance(vec, [10,10,10]::FLOAT[3]) LIMIT 1;
----
1

statement ok
BEGIN TRANSACTION;

statement ok
UPDATE t4 SET vec = [20, 20, 20] WHERE id = 1;

statement ok
ROLLBACK;

query I
SELECT count FROM pragma_hnsw_index_info() WHERE index_name = 't4_idx';
----
1

query I
SELECT id FROM t4 ORDER BY array_distance(vec, [10,10,10]::FLOAT[3]) LIMIT 1;
----
1

# Read-only databases reject deletes before the HNSW index can be mutated.
load {TEST_DIR}/temp_index_hnsw_crud_storage.db readonly

statement error
DELETE FROM t1;
----
read-only mode

query I
SELECT count FROM pragma_hnsw_index_info() WHERE index_name = 'my_idx';
----
1

query I
SELECT * FROM t1 ORDER BY array_distance(vec, [1,2,3]::FLOAT[3]) LIMIT 1;
----
[5.0, 5.0, 5.0]
